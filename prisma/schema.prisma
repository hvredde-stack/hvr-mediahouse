// HVR Media House — database schema
// Runs on Postgres (Vercel Storage / Neon). DATABASE_URL is the pooled
// connection string injected by Vercel; the runtime uses @prisma/adapter-pg.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Team members who can log into the admin ──────────────────────────
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("member") // owner | admin | member | client
  clientId     String? // set only for portal (client) logins
  client       Client?  @relation("ClientUsers", fields: [clientId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  tasks        Task[]   @relation("AssignedTasks")
}

// ── A lead/inquiry captured from the website contact form ────────────
model Lead {
  id                String   @id @default(cuid())
  name              String
  email             String
  phone             String?
  company           String?
  service           String?
  budget            String?
  message           String
  source            String   @default("contact_form") // contact_form | ai_chat | other
  status            String   @default("new") // new | contacted | won | lost
  convertedClientId String? // set when a lead is turned into a client
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ── A client the agency works with (the hub of the admin) ────────────
model Client {
  id           String        @id @default(cuid())
  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  platforms    String? // comma-separated, e.g. "Instagram, TikTok"
  plan         String? // Starter | Growth | Scale | Custom
  retainer     Int           @default(0) // monthly retainer in whole dollars
  status       String        @default("active") // onboarding | active | paused | churned
  startDate    DateTime?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  projects     Project[]
  content      ContentItem[]
  invoices     Invoice[]
  tasks        Task[]
  users        User[]        @relation("ClientUsers")
  reports      Report[]
  knowledge    KnowledgeDoc[]

  // ── AI voice agent config (read by the Pipecat agent) ──────────────
  voiceSlug        String?  @unique @map("voice_slug") // landing-page + outbound routing
  voicePrompt      String?  @map("voice_prompt") // the agent persona/script
  voiceName        String?  @default("Ara") @map("voice_name") // Grok voice
  voiceActive      Boolean  @default(false) @map("voice_active")
  twilioAccountSid String?  @map("twilio_account_sid") // BYO Twilio (Model B); null → shared account
  twilioAuthToken  String?  @map("twilio_auth_token") // Fernet-encrypted
  voiceTranscribe  Boolean  @default(false) @map("voice_transcribe") // store full transcripts?
  agentNumbers     AgentNumber[]
  voiceLeads       VoiceLead[]
  voiceCalls       VoiceCall[]
}

// ── A lead captured by the voice agent (IG/ad form, or during a call) ────────
model VoiceLead {
  id        String      @id @default(cuid())
  clientId  String      @map("client_id")
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String?
  email     String?
  phone     String
  source    String      @default("instagram")
  consent   Boolean     @default(false)
  status    String      @default("new") // new | calling | called | booked | lost
  createdAt DateTime    @default(now()) @map("created_at")
  calls     VoiceCall[]

  @@index([clientId])
  @@map("voice_leads")
}

// ── One AI phone call: summary + outcome always; transcript only if enabled ──
model VoiceCall {
  id         String     @id @default(cuid())
  clientId   String     @map("client_id")
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId     String?    @map("lead_id")
  lead       VoiceLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  callSid    String?    @map("call_sid")
  direction  String? // inbound | outbound
  status     String     @default("in_progress") // in_progress | completed | failed
  outcome    String? // booked | qualified | transferred | no_outcome
  summary    String?
  transcript Json? // null unless the client enabled full transcripts
  startedAt  DateTime   @default(now()) @map("started_at")
  endedAt    DateTime?  @map("ended_at")

  @@index([clientId])
  @@map("voice_calls")
}

// ── A phone number routed to a client's voice agent (a client may have many) ──
model AgentNumber {
  id          String   @id @default(cuid())
  clientId    String   @map("client_id")
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  phoneNumber String   @unique @map("phone_number") // E.164
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@map("agent_numbers")
}

// ── A project / engagement for a client ──────────────────────────────
model Project {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  type      String    @default("campaign") // campaign | retainer | one-off
  status    String    @default("planning") // planning | active | review | complete | on-hold
  startDate DateTime?
  dueDate   DateTime?
  budget    Int       @default(0)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tasks     Task[]
}

// ── A piece of content (idea → drafting → scheduled → published) ──────
model ContentItem {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform     String    @default("instagram") // instagram | tiktok | youtube | facebook | other
  title        String
  caption      String?
  status        String    @default("idea") // idea | drafting | scheduled | published
  approval      String    @default("pending") // pending | approved | changes
  clientComment String? // client's feedback when requesting changes
  scheduledFor  DateTime? // null = idea backlog
  assetUrl      String?
  notes         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ── An invoice for a client ──────────────────────────────────────────
model Invoice {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number    String    @unique
  amount    Int       @default(0) // whole dollars
  status    String    @default("draft") // draft | sent | paid | overdue
  issueDate DateTime?
  dueDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ── A to-do, optionally tied to a client/project and assigned ────────
model Task {
  id         String    @id @default(cuid())
  title      String
  done       Boolean   @default(false)
  dueDate    DateTime?
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId String?
  assignee   User?     @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
}

// ── A monthly performance snapshot for a client (manual entry) ────────
model Report {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month       DateTime // first day of the month it covers
  followers   Int      @default(0)
  reach       Int      @default(0)
  engagements Int      @default(0)
  leads       Int      @default(0)
  spend       Int      @default(0) // ad spend in whole dollars
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientId, month])
}

// ── A knowledge-base entry for a client's AI voice agent (RAG) ────────
// The CLIENT manages these from their portal. `embedding` is a pgvector
// column written via raw SQL (Prisma can't type the `vector` type). The
// voice agent reads this table by tenant_id (= the client's id) to answer
// callers. Requires the pgvector extension:
//   psql "$DATABASE_URL" -c "create extension if not exists vector;"
model KnowledgeDoc {
  id        String                       @id @default(cuid())
  clientId  String                       @map("tenant_id")
  client    Client                       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  content   String
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                     @default(now()) @map("created_at")

  @@index([clientId])
  @@map("kb_docs")
}
